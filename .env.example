# Copy this file to .env and fill in whichever integrations you have.
# Nothing here is required to run the app locally — every integration
# degrades to a safe simulated/demo mode when its keys are absent.

# Public base URL used when building the welcome link sent at checkout.
APP_BASE_URL=https://app.medfit.health

# --- AI Coach (Anthropic) ---
# Without this, the coach uses scripted demo answers for grocery lists,
# shake/dinner recipes, and restaurant guidance.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# --- Live web search for restaurant/menu questions (optional, used only
# alongside ANTHROPIC_API_KEY) ---
# Get a key at serper.dev, or swap lib/coachEngine.js's webSearch() for
# whatever search API you prefer (Brave Search, Bing, etc).
SERPER_API_KEY=

# --- Email delivery (SendGrid) ---
SENDGRID_API_KEY=
NOTIFY_FROM_EMAIL=welcome@medfit.health

# --- SMS delivery (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Remedora checkout webhook ---
# Without this, incoming webhooks are accepted unverified (dev/demo mode) —
# a warning is logged on every request. Set this in production so requests
# are rejected unless signed with your real Remedora signing secret.
# Find it in Remedora under Settings > Webhooks > (your endpoint) > Signing
# secret. The endpoint to register with Remedora is:
#   {APP_BASE_URL}/api/checkout/webhook
REMEDORA_SIGNING_SECRET=

PORT=3210
